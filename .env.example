# Canonical site URL (used for canonical tags, sitemap and Open Graph). Set once the domain is known.
NEXT_PUBLIC_SITE_URL=

# Service request delivery: configure ONE of the options below.

# Option A: email via Resend (https://resend.com). LEAD_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# Option B: webhook (Zapier, Make, a CRM...). Receives the request as JSON.
LEAD_WEBHOOK_URL=
